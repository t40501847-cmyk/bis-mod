package com.example.examplemod;

import net.fabricmc.api.ModInitializer;
import net.fabricmc.fabric.api.command.v2.CommandRegistrationCallback;
import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
import net.minecraft.entity.EntityType;
import net.minecraft.entity.mob.WardenEntity;
import net.minecraft.server.command.CommandManager;
import net.minecraft.server.command.ServerCommandSource;
import net.minecraft.server.network.ServerPlayerEntity;
import net.minecraft.server.world.ServerWorld;
import net.minecraft.text.Text;
import net.minecraft.util.math.Vec3d;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.TimeUnit;

public class ExampleMod implements ModInitializer {

    // Сколько тиков длится подъём (20 тиков = 1 секунда)
    private static final int RISE_TICKS = 20;
    private static final double RISE_HEIGHT = 5.0;

    // Игроки, которые сейчас "поднимаются"
    private static final Map<UUID, RisingData> RISING = new HashMap<>();

    private static class RisingData {
        int ticksLeft;
        final double startY;
        final double targetY;
        final double x;
        final double z;

        RisingData(int ticksLeft, double startY, double targetY, double x, double z) {
            this.ticksLeft = ticksLeft;
            this.startY = startY;
            this.targetY = targetY;
            this.x = x;
            this.z = z;
        }
    }

    @Override
    public void onInitialize() {
        // ---------- Команда /bis ----------
        CommandRegistrationCallback.EVENT.register((dispatcher, registryAccess, environment) -> {
            dispatcher.register(CommandManager.literal("bis")
                    .requires(source -> source.hasPermissionLevel(2))
                    .executes(context -> {
                        ServerCommandSource source = context.getSource();
                        ServerPlayerEntity player = source.getPlayerOrThrow();
                        ServerWorld world = (ServerWorld) player.getWorld();

                        // Спавним 10 варденов по кругу
                        List<WardenEntity> wardens = new ArrayList<>();
                        for (int i = 0; i < 10; i++) {
                            double angle = (2 * Math.PI / 10) * i;
                            double radius = 3.0;
                            double x = player.getX() + Math.cos(angle) * radius;
                            double z = player.getZ() + Math.sin(angle) * radius;

                            WardenEntity warden = EntityType.WARDEN.create(world);
                            if (warden != null) {
                                warden.refreshPositionAndAngles(x, player.getY(), z, 0, 0);
                                warden.setTarget(null); // не атакует
                                warden.setPersistent();
                                world.spawnEntity(warden);
                                lookAtPlayer(warden, player);
                                wardens.add(warden);
                            }
                        }

                        source.sendFeedback(() -> Text.literal("Вардены призваны..."), false);

                        // Через 2 секунды начинаем подъём
                        CompletableFuture.delayedExecutor(2, TimeUnit.SECONDS).execute(() -> {
                            source.getServer().execute(() -> {
                                ServerPlayerEntity p = source.getServer()
                                        .getPlayerManager().getPlayer(player.getUuid());
                                if (p == null) return;

                                // Стартуем плавный подъём
                                RISING.put(p.getUuid(), new RisingData(
                                        RISE_TICKS,
                                        p.getY(),
                                        p.getY() + RISE_HEIGHT,
                                        p.getX(),
                                        p.getZ()
                                ));
                            });
                        });

                        return 1;
                    }));
        });

        // ---------- Тик: плавный подъём ----------
        ServerTickEvents.END_SERVER_TICK.register(server -> {
            if (RISING.isEmpty()) return;

            List<UUID> finished = new ArrayList<>();

            for (Map.Entry<UUID, RisingData> entry : RISING.entrySet()) {
                ServerPlayerEntity player = server.getPlayerManager().getPlayer(entry.getKey());
                if (player == null) {
                    finished.add(entry.getKey());
                    continue;
                }

                RisingData data = entry.getValue();
                data.ticksLeft--;

                double progress = 1.0 - (double) data.ticksLeft / RISE_TICKS; // 0..1
                double newY = data.startY + (data.targetY - data.startY) * progress;

                // Плавное перемещение
                player.requestTeleport(data.x, newY, data.z);
                // Обнуляем падение, чтобы гравитация не тянула вниз
                player.setVelocity(0, 0, 0);
                player.fallDistance = 0f;

                if (data.ticksLeft <= 0) {
                    finished.add(entry.getKey());

                    // Финал: смерть и кик
                    player.kill();
                    player.networkHandler.disconnect(
                            Text.literal("Ты был кикнут командой /bis")
                    );
                }
            }

            finished.forEach(RISING::remove);
        });
    }

    private static void lookAtPlayer(WardenEntity warden, ServerPlayerEntity player) {
        Vec3d wardenPos = warden.getPos();
        Vec3d playerPos = player.getPos();
        double dx = playerPos.x - wardenPos.x;
        double dy = playerPos.y - wardenPos.y;
        double dz = playerPos.z - wardenPos.z;
        double distanceXZ = Math.sqrt(dx * dx + dz * dz);

        float yaw = (float) (Math.toDegrees(Math.atan2(dz, dx)) - 90.0F);
        float pitch = (float) (-Math.toDegrees(Math.atan2(dy, distanceXZ)));

        warden.setYaw(yaw);
        warden.setPitch(pitch);
        warden.headYaw = yaw;
        warden.bodyYaw = yaw;
    }
}
